# Copy to .env and set your API-Football v3 key.
API_FOOTBALL_KEY=
# Generate with a password manager or `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SECRET_KEY=
# Set true behind HTTPS in production; local HTTP development can leave this false.
COOKIE_SECURE=false
# Optional SQLAlchemy URL. Defaults to the local SQLite database in WAL mode.
DATABASE_URL=sqlite:///data/accalab.sqlite3
ACCALAB_DAILY_ENRICHMENT_BUDGET=1000
# Optional comma-separated IDs to restrict ingestion. Leave blank for all current leagues.
API_FOOTBALL_LEAGUE_IDS=
# Optional payment adapter: manual (default) or paychangu.
PAYMENT_PROVIDER=manual
# PayChangu credentials are supplied only through the runtime environment.
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
# Required for PayChangu return/callback URLs; use the public HTTPS origin.
PUBLIC_BASE_URL=
# Telegram credentials are supplied only through the runtime environment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Configure this exact value as Telegram's webhook secret_token.
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Cloud API remains disabled until policy, country and licensing eligibility are confirmed.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=
META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Optional email fallback transport. Set credentials only in the runtime environment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
